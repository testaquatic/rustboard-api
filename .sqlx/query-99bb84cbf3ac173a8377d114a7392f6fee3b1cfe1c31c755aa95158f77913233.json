  "query": "\n            UPDATE posts\n            SET title = COALESCE($2, title),\n                body = COALESCE($3, body),\n                updated_at = NOW()\n            WHERE id = $1\n            RETURNING id, title, body, author_id, created_at, updated_at\n            ",
