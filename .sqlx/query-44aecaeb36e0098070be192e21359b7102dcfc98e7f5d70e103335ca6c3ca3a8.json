{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                p.id,\n                p.title,\n                p.content,\n                p.author_id,\n                p.created_at,\n                p.updated_at,\n                u.email AS author_email,\n                u.display_name AS author_display_name\n            FROM posts p\n            JOIN users u ON p.author_id = u.id\n            ORDER BY p.created_at DESC\n            LIMIT $1 OFFSET $2\n            ",
